# Nemoris LLM service (OpenCode proxy) — copy to .env and adjust
# Loaded from apps/llm-service/.env only (not the monorepo root .env)

PORT=4096

# Default model when the client does not pass one (provider/model — run: opencode models openai --refresh)
OPENAI_MODEL=google/gemini-2.5-flash

# Optional: reasoning variant for some OpenAI / GPT-5.x models (see: opencode run --help)
# OPENCODE_VARIANT=medium
