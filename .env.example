# Server
PORT=3001
NODE_ENV=development

# Database (native Postgres on host, port 5442, database "nemoris")
DATABASE_URL=postgresql://nemoris:nemoris123@localhost:5442/nemoris

# WAHA - WhatsApp HTTP API
WAHA_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=

# Chroma - Vector Database
CHROMA_URL=http://localhost:8000

# LLM Provider Configuration
# Options: "openai" (default), "local", "ollama", "lmstudio", "opencode"
LLM_PROVIDER=opencode

# For OpenAI (default)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# For Local LLM (Ollama, LM Studio, OpenCode Proxy, etc.)
# Example: http://localhost:11434 (Ollama default)
# Example: http://localhost:1234 (LM Studio default)
# Example: http://localhost:4096 (OpenCode Proxy - see below)
LLM_URL=http://localhost:4096

# Model for local LLM
# OpenCode: google/gemini-2.5-flash, google/gemini-2.5-pro
# Ollama: llama3, mistral, codellama, etc.
# LM Studio: any model you've downloaded
OPENAI_MODEL=google/gemini-2.5-flash

# App Settings
REMINDER_CHECK_INTERVAL=* * * * *  # Every minute
MAX_MEMORIES_RETRIEVED=3
MESSAGE_HISTORY_LIMIT=5

# Anti-Ban Settings
MIN_MESSAGE_DELAY=3000  # Minimum ms between messages (WhatsApp rate limit protection)
MAX_MESSAGE_DELAY=8000  # Maximum ms between messages (randomize to seem more human)

# Logging
LOG_LEVEL=info
