# Server
PORT=3001
NODE_ENV=development

# Database (native Postgres on host, port 5442, database "nemoris")
DATABASE_URL=postgresql://nemoris:nemoris123@localhost:5442/nemoris

# WAHA - WhatsApp HTTP API (host port matches docker-compose nemoris_waha 4130:3000)
WAHA_URL=http://localhost:4130
WAHA_SESSION=default
# Must match WAHA_API_KEY in docker/waha.env when using Docker WAHA Plus
WAHA_API_KEY=

# Chroma - Vector Database
CHROMA_URL=http://localhost:8000

# LLM Provider Configuration
# Options: "openai" (default), "local", "ollama", "lmstudio", "opencode"
LLM_PROVIDER=opencode

# For OpenAI (default)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# For Local LLM (Ollama, LM Studio, OpenCode Proxy, etc.)
# Example: http://localhost:11434 (Ollama default)
# Example: http://localhost:1234 (LM Studio default)
# Example: http://localhost:4096 (OpenCode Proxy - see below)
LLM_URL=http://localhost:4096

# OpenCode proxy (`npm run proxy`) loads apps/llm-service/.env for PORT, OPENAI_MODEL, OPENCODE_VARIANT

# Model for local LLM
# OpenCode: run `opencode models openai --refresh` and use the exact id (e.g. openai/gpt-5.4)
# Ollama: llama3, mistral, codellama, etc.
# LM Studio: any model you've downloaded
OPENAI_MODEL=google/gemini-2.5-flash

# OpenCode only: some models (e.g. GPT-5.x via subscription) require a variant — see `opencode run --help`
# OPENCODE_VARIANT=medium

# App Settings
REMINDER_CHECK_INTERVAL=* * * * *  # Every minute
MAX_MEMORIES_RETRIEVED=3
MESSAGE_HISTORY_LIMIT=5

# Anti-Ban Settings
MIN_MESSAGE_DELAY=3000  # Minimum ms between messages (WhatsApp rate limit protection)
MAX_MESSAGE_DELAY=8000  # Maximum ms between messages (randomize to seem more human)

# Logging
LOG_LEVEL=info
