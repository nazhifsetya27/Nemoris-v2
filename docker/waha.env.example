# Copy to waha.env (gitignored): cp waha.env.example waha.env
#
# Shared by WAHA Core (free) and WAHA Plus — same variables; only the Docker image + session
# mount path in docker-compose.yml differ (see comments there).
# Put the same WAHA_API_KEY in the repo root .env so nemoris_backend sends X-Api-Key.

WAHA_API_KEY=generate-a-long-random-string
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=change-me

# Local pairing — use true for dashboard QR
WAHA_PRINT_QR=true

# Webhook FROM INSIDE the WAHA container (not localhost). Backend on Mac host:
WHATSAPP_HOOK_URL=http://host.docker.internal:3001/webhook
# Backend in same Compose stack:
# WHATSAPP_HOOK_URL=http://nemoris_backend:3001/webhook
WHATSAPP_HOOK_EVENTS=*
